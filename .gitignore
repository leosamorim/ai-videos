# Public engine allowlist; unknown root files and folders remain private.
/*
!/.gitignore
!/.gitattributes
!/.editorconfig
!/.env.example
!/README.md
!/AGENTS.md
!/CLAUDE.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/CHANGELOG.md
!/CONTRIBUTING.md
!/CODE_OF_CONDUCT.md
!/SECURITY.md
!/SUPPORT.md
!/package.json
!/package-lock.json
!/.release-manifest.json
!/scripts/
!/tests/
!/templates/
!/docs/
!/vendor/
!/.github/
!/.claude/
/.claude/*
!/.claude/skills/
!/.claude/settings.json
!/.agents/
/.agents/*
!/.agents/skills/
!/.codex/
/.codex/*
!/.codex/config.toml
!/library/
/library/*
!/library/SOURCES.md
!/library/sources.json
!/library/references/
/library/references/*
!/library/references/README.md
/docs/RESEARCH-*
/docs/private/
**/node_modules/
**/__pycache__/
**/.cache/
**/.env
**/.env.*
!/.env.example
*.log
*.pyc
*.mp4
*.mov
*.mkv
*.webm
*.wav
*.mp3
*.aac
*.m4a
*.flac
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.woff
*.woff2
!templates/fonts/inter-latin-400-normal.woff2
!templates/fonts/inter-latin-600-normal.woff2
!templates/fonts/inter-latin-700-normal.woff2
gsap.min.js
.DS_Store
